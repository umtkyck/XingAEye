# Server Configuration
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_IOT_ENDPOINT=xxxxx.iot.us-east-1.amazonaws.com
AWS_S3_BUCKET=xingaeye-videos
AWS_DYNAMODB_TABLE=xingaeye-devices

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xingaeye
DB_USER=postgres
DB_PASSWORD=postgres

# Twilio Configuration (SMS Alerts)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid Configuration (Email Alerts)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=alerts@xingaeye.com

# Video Configuration
VIDEO_MAX_DURATION=300
VIDEO_RETENTION_DAYS=30

# Alert Configuration
ALERT_MAX_RETRIES=3
ALERT_RETRY_DELAY=5000
